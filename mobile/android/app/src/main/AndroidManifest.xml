<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Reminders. POST_NOTIFICATIONS is runtime-requested on API 33+.
      SCHEDULE_EXACT_ALARM is the user-granted route: Play restricts the
      auto-granted USE_EXACT_ALARM to alarm/calendar apps, so a habit app must
      request this one and degrade to inexact if refused.
      RECEIVE_BOOT_COMPLETED lets reminders survive a reboot — without it every
      scheduled alarm is silently dropped when the phone restarts.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Screen time. A signature-level permission that an ordinary app can hold
      only because the user grants it by hand in
      Settings > Special app access > Usage access — the manifest entry alone
      grants nothing, it only makes the app eligible to appear in that list, so
      `tools:ignore` here is accurate rather than a suppression of a real problem.

      Play requires a prominent in-app disclosure BEFORE this is requested:
      `ScreenTimeDisclosureScreen` states what is read, what it is used for, and
      that it never leaves the device, and the settings screen is only opened
      after the user accepts it. The data is written to the local database and
      is excluded from the backup payload.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Auto Backup stays disabled. It would otherwise snapshot the Drift SQLite
      database to the user's Drive uncoordinated with our own encrypted backup —
      capturable mid-write and restorable stale onto a new device — and would also
      upload the Supabase session carried over from the Capacitor build.
    -->
    <application
        android:label="StayHardy"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- The password-reset email links to stayhardy.com/auth/reset.
                 With this filter Android offers the app for that link, and
                 supabase_flutter finishes the recovery in-app — the fix for
                 "the link just loads the website". autoVerify stays off until
                 assetlinks.json is published on the domain. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="stayhardy.com"
                      android:pathPrefix="/auth/reset"/>
            </intent-filter>

            <!--
              Deep links carried over verbatim from the Capacitor build. Existing
              users have password-reset and email-confirmation links already sitting
              in their inboxes pointing at these; dropping any of them breaks those
              links permanently. The autoVerify App Link is backed by the two
              SHA-256 fingerprints published at stayhardy.com/.well-known/assetlinks.json.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="stayhardy.com" android:pathPrefix="/auth"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="stayhardy"/>
            </intent-filter>
        </activity>

        <!--
          Widget receivers carried over verbatim from the Capacitor build.
          An installed AppWidget is bound to a ComponentName (package + class),
          so these names and the provider XML they point at must never change —
          renaming either turns every already-placed widget into a dead box the
          user has to remove and re-add by hand.
        -->
        <receiver
            android:name=".StayHardyWidget"
            android:exported="true"
            android:label="@string/widget_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stayhardy_widget_info" />
        </receiver>

        <receiver
            android:name=".StayHardyWidgetSmall"
            android:exported="true"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stayhardy_widget_small_info" />
        </receiver>


        <!-- Re-arms scheduled reminders after a reboot. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!--
          Lets screen time resolve app NAMES for the packages it already sees.
          Deliberately scoped to launchable apps rather than requesting
          QUERY_ALL_PACKAGES: that is a sensitive permission needing its own Play
          declaration, and the only thing gained would be labels for background
          services the user never opened. Anything still invisible falls back to
          its package name.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
